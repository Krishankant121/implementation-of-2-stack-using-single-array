
#include<iostream>
using namespace std;
class stack{
    public:
    int*arr;
    int size;
    int top1;
    int top2;

    stack(int capacity){
        arr=new int[capacity];
        size=capacity;
        top1=-1;
        top2=size;
    }

    void push1(int value){
        if(top2-top1==1){
            cout<<"Stack is full";
        }
        else{
             top1++;
            arr[top1]=value;
        }
       
    }
    void push2(int value){
        if(top2-top1==1){
            cout<<"stack is full"<<endl;
        }
        top2--;
        arr[top2]=value;
    }
    void pop1(){
        if(top1==-1){
            cout<<"stack is undergflow"<<endl;
        }
        else{
            arr[top1]=-1;
            top1--;
        }
        
    }
    void pop2(){
        if(top2==size){
            cout<<"stack is underflow"<<endl;
            
        }
        else{
            arr[top2]==-1;
            top2++;
        }
    }
    void print(){
        for(int i=0;i<size;i++){
            cout<<arr[i]<<" ";
        }cout<<endl;
    }
};
int main() {
    stack s(4);
    s.push1(20);
    s.push2(10);
    s.push1(20);
    s.push2(10);
    s.push1(40);
    s.print();
    return 0;
}
